<% title(I18n.t('devise.general.login')) %>
<h2 class='my-3'><%= I18n.t('devise.general.login') %></h1>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), data: { turbo: false }) do |f| %>
  <div class="form-floating">
    <%= f.email_field :email, class: 'form-control', autofocus: true, autocomplete: "email", placeholder: "name@example.com", required: true %>
    <%= f.label :email, _('Email'), for: 'user_email' %>
  </div>

  <div class="form-floating">
    <%= f.password_field :password, class: 'form-control', autocomplete: "current-password", placeholder: 'password', required: true %>
    <%= f.label :password, _('Password'), for: 'user_password' %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="checkbox mt-3">
      <label>
        <%= f.check_box :remember_me %> <%= I18n.t('devise.general.remember_me') %>
      </label>
    </div>
  <% end %>

  <button class="w-100 btn btn-lg btn-primary mt-3" type="submit"><%= I18n.t('devise.general.login') %></button>
<% end %>

<% if devise_mapping.omniauthable? && resource_class.omniauth_providers.include?(:microsoft_graph) %>
  <div class="text-center my-3">
    <span class="text-muted">— or —</span>
  </div>
  <%= button_to user_microsoft_graph_omniauth_authorize_path,
    method: :post,
    data: { turbo: false },
    class: "w-100 btn btn-lg btn-outline-primary" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 21 21" class="me-2">
      <rect x="1" y="1" width="9" height="9" fill="#f25022"/>
      <rect x="1" y="11" width="9" height="9" fill="#00a4ef"/>
      <rect x="11" y="1" width="9" height="9" fill="#7fba00"/>
      <rect x="11" y="11" width="9" height="9" fill="#ffb900"/>
    </svg>
    Sign in with Microsoft
  <% end %>
<% end %>
