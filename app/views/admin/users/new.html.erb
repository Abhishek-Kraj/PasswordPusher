<% content_for :title, _("Invite User") %>

<% content_for :breadcrumbs do %>
  <li class="breadcrumb-item">
    <div class="d-flex align-items-center">
      <svg class="text-muted me-1" width="16" height="16" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
      </svg>
      <%= link_to _("Administrator Management"), admin_users_path, class: "text-muted small text-decoration-none" %>
    </div>
  </li>
  <li class="breadcrumb-item">
    <div class="d-flex align-items-center">
      <svg class="text-muted me-1" width="16" height="16" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
      </svg>
      <span class="text-muted small"><%= _("Invite User") %></span>
    </div>
  </li>
<% end %>

<div class="card shadow-sm">
  <div class="card-header border-bottom">
    <div class="d-flex align-items-center">
      <svg class="text-primary me-3" width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
      </svg>
      <div>
        <h1 class="h4 fw-bold text-dark mb-1"><%= _("Invite User") %></h1>
        <p class="text-muted small mb-0"><%= _("Create a new user account and send an invitation email") %></p>
      </div>
    </div>
  </div>

  <div class="card-body">
    <% unless Settings.enable_user_account_emails %>
      <div class="alert alert-warning d-flex align-items-start mb-4" role="alert">
        <svg class="me-2 flex-shrink-0 mt-1" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        <div>
          <strong><%= _("Email delivery may not be configured.") %></strong>
          <%= _("User account emails are currently disabled. The invitation email may not be delivered.") %>
        </div>
      </div>
    <% end %>

    <div class="alert alert-info d-flex align-items-start mb-4" role="alert">
      <svg class="me-2 flex-shrink-0 mt-1" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <div>
        <%= _("An email with password reset instructions will be sent to this address. The user can set their own password.") %>
      </div>
    </div>

    <%= form_with model: @user, url: admin_users_path, method: :post, local: true do |f| %>
      <% if @user.errors.any? %>
        <div class="alert alert-danger mb-4" role="alert">
          <ul class="mb-0">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :email, _("Email Address"), class: "form-label fw-medium" %>
        <%= f.email_field :email, class: "form-control", placeholder: "user@example.com", autofocus: true, required: true %>
      </div>

      <div class="mb-4">
        <div class="form-check">
          <%= f.check_box :admin, class: "form-check-input" %>
          <%= f.label :admin, _("Grant administrator privileges"), class: "form-check-label" %>
        </div>
      </div>

      <div class="d-flex gap-2">
        <%= f.submit _("Send Invitation"), class: "btn btn-primary d-flex align-items-center" %>
        <%= link_to _("Cancel"), admin_users_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>
